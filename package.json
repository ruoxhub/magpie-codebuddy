{
  "name": "magpie-codebuddy",
  "version": "0.1.0",
  "description": "CodeBuddy (Tencent Cloud coding assistant) provider for Magpie: the China build (copilot.tencent.com) and the international one (www.codebuddy.ai), with browser sign-in, the local IDE's sign-in, API keys, credits and daily check-in",
  "type": "module",
  "main": "./opencode.mjs",
  "exports": {
    ".": {
      "import": "./opencode2.mjs",
      "default": "./opencode2.mjs"
    }
  },
  "keywords": [
    "magpie-plugin",
    "opencode-plugin",
    "opencode",
    "provider",
    "codebuddy",
    "workbuddy",
    "tencent"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "files": [
    "index.mjs",
    "opencode.mjs",
    "opencode2.mjs",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "magpie": {
    "icon": "data:image/svg+xml;base64,",
    "maxConcurrency": 4
  }
}
